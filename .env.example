# --- Fluxer ---------------------------------------------------------------
# Origin of your Fluxer instance; endpoints are discovered from /.well-known/fluxer
FLUXER_INSTANCE=https://your-instance.example
# Bot token ("<application_id>.<secret>") from POST /v1/oauth2/applications
FLUXER_BOT_TOKEN=

# Anyone who messages the bot gets their own CSS and their own personal URL (see
# PUBLIC_BASE_URL below) — this is optional now, not a gate on who can use the bot.
# Set it to your own Fluxer user ID if you also want your own commands to write the local
# file / inject via CDP into the Fluxer client running on THIS machine (the two sinks below);
# everyone else only gets the shared HTTP URL, since those two only make sense for whoever is
# actually running this process.
OWNER_USER_ID=

# --- Lemonade (local AI) --------------------------------------------------
LEMONADE_URL=http://127.0.0.1:13305/api/v1
LEMONADE_MODEL=Qwen3-4B-Instruct-2507-GGUF
# LEMONADE_API_KEY=

# --- Command prefix --------------------------------------------------------
PREFIX=!

# Delete a user's own `!css ...` command message after handling it. Needs the bot to have
# MANAGE_MESSAGES in the channel (it can't delete someone else's message otherwise); the bot
# logs a warning and leaves messages alone if it doesn't have that permission.
# DELETE_COMMAND_MESSAGES=true

# --- Where generated CSS gets injected (any combination) -------------------
# 1) Everyone's CSS is always served at PUBLIC_BASE_URL/css/<their-user-id>.css — this is the
#    one every other user actually relies on. Set this to a hostname that reaches this same
#    port from outside this machine, e.g. a Cloudflare Tunnel hostname (see README: "Hosting
#    this for other people"). Left unset, it falls back to a loopback URL nobody else can open.
# PUBLIC_BASE_URL=https://css.your-domain.example
CSS_SERVER_PORT=7878
# 2) OWNER_USER_ID's own commands also write this file, for a client's custom-CSS slot on
#    this same machine to load / you to paste from.
CSS_OUTPUT_PATH=./data/custom.css
# 3) OWNER_USER_ID's own commands also live-inject via Chrome DevTools Protocol. Launch the
#    desktop client (Electron) or browser with --remote-debugging-port=9222 and set:
# CDP_URL=http://127.0.0.1:9222

# --- Optional: upload saved profiles as Fluxer themes ----------------------
# Theme upload needs a USER session token (bots get 403), and only ever acts as the one
# account this token belongs to — so `!css save <name> --upload` only works for OWNER_USER_ID,
# never on behalf of whoever else is chatting with the bot. Use at your own risk; automating a
# user account may be against your instance's rules.
# FLUXER_USER_TOKEN=

DATA_DIR=./data
