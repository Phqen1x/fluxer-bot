# --- Fluxer ---------------------------------------------------------------
# Origin of your Fluxer instance; endpoints are discovered from /.well-known/fluxer
FLUXER_INSTANCE=https://your-instance.example
# Bot token ("<application_id>.<secret>") from POST /v1/oauth2/applications
FLUXER_BOT_TOKEN=
# Your own user ID. The bot ONLY obeys this user.
OWNER_USER_ID=

# --- Lemonade (local AI) --------------------------------------------------
LEMONADE_URL=http://127.0.0.1:13305/api/v1
LEMONADE_MODEL=Qwen3-4B-Instruct-2507-GGUF
# LEMONADE_API_KEY=

# --- Command prefix --------------------------------------------------------
PREFIX=!

# Delete the owner's own `!css ...` command message after handling it. Needs the bot to have
# MANAGE_MESSAGES in the channel (it can't delete someone else's message otherwise); the bot
# logs a warning and leaves messages alone if it doesn't have that permission.
# DELETE_COMMAND_MESSAGES=true

# --- Where generated CSS gets injected (any combination) -------------------
# 1) Write to a file your client's custom-CSS slot loads / you paste from
CSS_OUTPUT_PATH=./data/custom.css
# 2) Serve http://127.0.0.1:PORT/custom.css (use @import in the client's CSS box once)
CSS_SERVER_PORT=7878
# 3) Live-inject via Chrome DevTools Protocol. Launch the desktop client (Electron)
#    or browser with --remote-debugging-port=9222 and set:
# CDP_URL=http://127.0.0.1:9222

# --- Optional: upload saved profiles as Fluxer themes ----------------------
# Theme upload needs a USER session token (bots get 403). Use at your own risk;
# automating a user account may be against your instance's rules.
# FLUXER_USER_TOKEN=

DATA_DIR=./data
